{
	"name": "environment",
	"dockerComposeFile": "compose.yaml",
	"service": "environment",
	"workspaceFolder": "/workspace",
	"containerEnv": {
		"COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
	},
	"onCreateCommand": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
	"updateContentCommand": ["/bin/bash", "-i", "-c", "pnpm i --frozen-lockfile"],
	"features": {
		"ghcr.io/devcontainers/features/git:1.3.8": {
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/rust:1": {
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/node:2.1.0": {
			"version": "latest",
			"pnpmVersion": "latest"
		},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"version": "latest",
			"moby": false,
			"installDockerBuildx": true,
			"installComposeSwitch": true
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"editorconfig.editorconfig",
				"biomejs.biome",
				"ms-azuretools.vscode-containers",
				"ms-vscode-remote.remote-containers",
				"ms-azuretools.vscode-docker",
				"redhat.vscode-yaml",
				"bufbuild.vscode-buf"
			]
		}
	}
}
