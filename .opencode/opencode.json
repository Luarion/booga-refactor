{
	"$schema": "https://opencode.ai/config.json",
	"lsp": true,
	"permissions": [
		{ "action": "edit", "resource": "*", "effect": "allow" },
		{ "action": "edit", "resource": ".devcontainer/*", "effect": "ask" },
		{ "action": "edit", "resource": ".github/*", "effect": "ask" },
		{ "action": "edit", "resource": ".opencode/*", "effect": "ask" },
		{ "action": "edit", "resource": ".vscode/*", "effect": "ask" },
		{ "action": "edit", "resource": ".editorconfig", "effect": "ask" },
		{ "action": "edit", "resource": ".gitattributes", "effect": "ask" },
		{ "action": "edit", "resource": ".npmrc", "effect": "ask" },
		{ "action": "edit", "resource": "biome.json", "effect": "ask" },
		{ "action": "edit", "resource": "*/biome.json", "effect": "ask" },
		{ "action": "edit", "resource": "commitlint.config.mjs", "effect": "deny" },
		{ "action": "edit", "resource": "lefthook.yaml", "effect": "ask" },
		{ "action": "edit", "resource": "package.json", "effect": "ask" },
		{ "action": "edit", "resource": "*/package.json", "effect": "ask" },
		{ "action": "edit", "resource": "pnpm-workspace.yaml", "effect": "ask" },
		{ "action": "edit", "resource": "tsconfig.json", "effect": "ask" },
		{ "action": "edit", "resource": "*/tsconfig.json", "effect": "ask" },
		{ "action": "shell", "resource": "*", "effect": "ask" },
		{ "action": "shell", "resource": "git branch *", "effect": "allow" },
		{ "action": "shell", "resource": "git diff *", "effect": "allow" },
		{ "action": "shell", "resource": "git log *", "effect": "allow" },
		{ "action": "shell", "resource": "git show *", "effect": "allow" },
		{ "action": "shell", "resource": "git status *", "effect": "allow" },
		{ "action": "shell", "resource": "grep *", "effect": "allow" },
		{ "action": "shell", "resource": "head *", "effect": "allow" },
		{ "action": "shell", "resource": "ls *", "effect": "allow" },
		{ "action": "shell", "resource": "pwd *", "effect": "allow" },
		{ "action": "shell", "resource": "rg *", "effect": "allow" },
		{ "action": "shell", "resource": "tail *", "effect": "allow" },
		{ "action": "shell", "resource": "wc *", "effect": "allow" }
	]
}
