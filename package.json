{
	"name": "booga",
	"private": true,
	"engines": {
		"node": "26.12.1"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.16.1",
			"onFail": "download"
		}
	},
	"scripts": {
		"lint": "biome check",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"clean": "git clean -fdX -e '*.env'",
		"reset": "pnpm clean && pnpm i --frozen-lockfile"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@devcontainers/cli": "0.89.0",
		"lefthook": "2.2.2",
		"nx": "24.0.0"
	}
}
