{
	"name": "booga",
	"private": true,
	"engines": {
		"node": "26.9.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.4.2",
			"onFail": "download"
		}
	},
	"scripts": {
		"lint": "biome check; yamllint **/*.yaml",
		"lint:fix": "biome check --apply .",
		"format": "biome format --write .",
		"clean": "git clean -fdX -e '*.env'",
		"reset": "pnpm clean && pnpm i --frozen-lockfile"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@devcontainers/cli": "0.89.0",
		"lefthook": "2.1.14",
		"nx": "23.2.1",
		"yaml-lint": "1.7.0"
	}
}
