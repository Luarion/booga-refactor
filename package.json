{
	"name": "booga",
	"private": true,
	"packageManager": "pnpm@11.5.3",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.5.3",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": ">=24.18.0 <26",
			"onFail": "ignore"
		}
	},
	"scripts": {
		"prepare": "husky",
		"lint": "biome check; yamllint **/*.yaml",
		"lint:fix": "biome check --apply .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@commitlint/cli": "21.0.1",
		"@commitlint/config-conventional": "21.0.1",
		"@devcontainers/cli": "0.87.0",
		"husky": "9.1.7",
		"lint-staged": "17.0.5",
		"nx": "23.0.1",
		"validate-branch-name": "1.3.2",
		"yaml-lint": "1.7.0"
	}
}
